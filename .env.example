# Copy this file to .env.local for local development.
# In production (Vercel), set these as Project Environment Variables instead —
# never commit real values to git.

# Octopus Energy API key, from https://octopus.energy/dashboard/developer/
OCTOPUS_API_KEY=REPLACE_WITH_YOUR_OCTOPUS_API_KEY

# Your Octopus account number, shown on the same developer page (starts with "A-")
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX
